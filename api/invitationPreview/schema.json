[
  {
    "namespace": "invitationPreview",
    "types": [
      {
        "id": "TargetCalendar",
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "isDefault": { "type": "boolean" }
        }
      },
      {
        "id": "StageDetails",
        "type": "object",
        "properties": {
          "sourceId": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64,
            "pattern": "^[a-f0-9]{64}$"
          },
          "preferredCalendarId": {
            "choices": [
              { "type": "string" },
              { "type": "null" }
            ],
            "optional": true
          },
          "targetCalendarId": {
            "choices": [
              { "type": "string" },
              { "type": "null" }
            ],
            "optional": true
          },
          "participationStatus": {
            "choices": [
              {
                "type": "string",
                "enum": ["ACCEPTED", "TENTATIVE", "DECLINED"]
              },
              { "type": "null" }
            ],
            "optional": true
          },
          "replyPending": {
            "type": "boolean",
            "optional": true
          }
        }
      },
      {
        "id": "StageResult",
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "staged",
              "updated",
              "alreadyPending",
              "alreadyProcessed",
              "cancelled",
              "cancellationPending",
              "ignored",
              "noCalendar",
              "calendarError"
            ]
          },
          "pending": { "type": "boolean" },
          "calendarId": { "type": "string", "optional": true },
          "itemId": { "type": "string", "optional": true },
          "targetCalendarId": { "type": "string", "optional": true },
          "targetCalendarName": { "type": "string", "optional": true },
          "cancellations": {
            "type": "array",
            "items": { "$ref": "CancellationCandidate" },
            "optional": true
          }
        }
      },
      {
        "id": "CancellationCandidate",
        "type": "object",
        "properties": {
          "calendarId": { "type": "string" },
          "itemId": { "type": "string" },
          "calendarName": { "type": "string" },
          "title": { "type": "string" },
          "startDate": { "type": "string", "optional": true },
          "endDate": { "type": "string", "optional": true },
          "allDay": { "type": "boolean" },
          "organizer": { "type": "string", "optional": true },
          "recurrenceId": {
            "choices": [
              { "type": "string" },
              { "type": "null" }
            ]
          }
        }
      },
      {
        "id": "AcceptanceResult",
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["accepted", "missing", "mismatch", "calendarError"]
          }
        }
      },
      {
        "id": "ResponseResult",
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["responded", "missing", "mismatch", "calendarError"]
          },
          "participationStatus": {
            "type": "string",
            "enum": ["ACCEPTED", "TENTATIVE", "DECLINED"],
            "optional": true
          }
        }
      },
      {
        "id": "CancellationResult",
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["deleted", "missing", "mismatch", "calendarError"]
          }
        }
      },
      {
        "id": "PreviewReference",
        "type": "object",
        "properties": {
          "calendarId": { "type": "string" },
          "itemId": { "type": "string" },
          "preferredCalendarId": {
            "choices": [
              { "type": "string" },
              { "type": "null" }
            ],
            "optional": true
          }
        }
      },
      {
        "id": "Resolution",
        "type": "object",
        "properties": {
          "sourceId": { "type": "string" },
          "calendarId": { "type": "string" },
          "itemId": { "type": "string" },
          "participationStatus": { "type": "string" }
        }
      },
      {
        "id": "PendingTransfer",
        "type": "object",
        "properties": {
          "sourceId": { "type": "string" },
          "calendarId": { "type": "string" },
          "itemId": { "type": "string" },
          "targetCalendarId": { "type": "string" },
          "participationStatus": {
            "type": "string",
            "enum": ["ACCEPTED", "TENTATIVE", "DECLINED"]
          },
          "replyPending": {
            "type": "boolean",
            "optional": true
          }
        }
      }
    ],
    "functions": [
      {
        "name": "listCalendars",
        "type": "function",
        "async": true,
        "parameters": [],
        "returns": {
          "type": "array",
          "items": { "$ref": "TargetCalendar" }
        }
      },
      {
        "name": "stage",
        "type": "function",
        "async": true,
        "parameters": [
          { "name": "icalText", "type": "string" },
          { "name": "details", "$ref": "StageDetails" }
        ],
        "returns": { "$ref": "StageResult" }
      },
      {
        "name": "inspect",
        "type": "function",
        "async": true,
        "parameters": [
          {
            "name": "references",
            "type": "array",
            "items": { "$ref": "PreviewReference" }
          }
        ],
        "returns": {
          "type": "array",
          "items": { "$ref": "PreviewReference" }
        }
      },
      {
        "name": "respondPreview",
        "type": "function",
        "async": true,
        "parameters": [
          { "name": "calendarId", "type": "string" },
          { "name": "itemId", "type": "string" },
          {
            "name": "participationStatus",
            "type": "string",
            "enum": ["ACCEPTED", "TENTATIVE", "DECLINED"]
          },
          {
            "name": "sendReply",
            "type": "boolean",
            "optional": true
          }
        ],
        "returns": { "$ref": "ResponseResult" }
      },
      {
        "name": "acceptPreview",
        "type": "function",
        "async": true,
        "parameters": [
          { "name": "calendarId", "type": "string" },
          { "name": "itemId", "type": "string" },
          {
            "name": "sendReply",
            "type": "boolean",
            "optional": true
          }
        ],
        "returns": { "$ref": "AcceptanceResult" }
      },
      {
        "name": "playReminderSound",
        "type": "function",
        "async": true,
        "parameters": [],
        "returns": { "type": "boolean" }
      },
      {
        "name": "deleteCancellation",
        "type": "function",
        "async": true,
        "parameters": [
          { "name": "icalText", "type": "string" },
          { "name": "calendarId", "type": "string" },
          { "name": "itemId", "type": "string" },
          {
            "name": "recurrenceId",
            "choices": [
              { "type": "string" },
              { "type": "null" }
            ]
          }
        ],
        "returns": { "$ref": "CancellationResult" }
      },
      {
        "name": "remove",
        "type": "function",
        "async": true,
        "parameters": [
          { "name": "calendarId", "type": "string" },
          { "name": "itemId", "type": "string" }
        ],
        "returns": { "type": "boolean" }
      }
    ],
    "events": [
      {
        "name": "onResolved",
        "type": "function",
        "parameters": [
          { "name": "resolution", "$ref": "Resolution" }
        ]
      },
      {
        "name": "onTransferPending",
        "type": "function",
        "parameters": [
          { "name": "transfer", "$ref": "PendingTransfer" }
        ]
      }
    ]
  }
]